# 游戏服务器
GAME_SERVER_PORT=3001
GAME_SERVER_HOST=0.0.0.0
# 单连接每秒消息上限，超出直接丢弃，防止单客户端打满 Tick
GAME_SERVER_MAX_MPS=120
# 出生点散布半径（像素）：越小越拥挤，压测时可放大
GAME_SPAWN_RADIUS=240
# 内容审核词库 JSON 路径（留空只用内置表；内置政治类只有占位条目，上线必须配置）
GAME_MODERATION_LEXICON=

# 园区身份：多园区部署时每台游戏服各配一个，/health 原样下发供选园页核对
GAME_PARK_ID=main
GAME_PARK_NAME=主园区

# 园区列表（只由主站机器的 Web 读取，JSON 数组）。
# 留空 = 单园区，行为与改造前完全一致；数组支持 N 项，顺序即选园页卡片的顺序。
# ws/health 可写相对路径（同源）或 wss:// / https:// 绝对地址（其余园区直连各自子域名）
# GAME_PARKS=[{"id":"a","name":"一号园区","ws":"/ws","health":"/health"},{"id":"b","name":"二号园区","ws":"wss://b.example.com/ws","health":"https://b.example.com/health"}]

# 部署角色：all(默认，主站机器) | web(只跑 Web) | game(每台游戏服机器)
DEPLOY_ROLE=all

# 浏览器侧 WebSocket 地址（留空则走同源 /ws；多园区部署时由 GAME_PARKS 决定，不要设这个）
NEXT_PUBLIC_GAME_WS_URL=

# 压测
BENCH_BOTS=200
BENCH_MS=20000