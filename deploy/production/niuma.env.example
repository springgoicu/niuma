# niuma 生产环境变量（服务器上位于 /etc/niuma/niuma.env）
#
# 这份文件是「运行时配置」，不进仓库：deploy.sh 会在构建前 source 它，
# 值再通过 pm2 --update-env 带进进程，所以改完不需要重新构建，重跑部署即可。
#
# 单机部署（一台 2C/3.6G/5Mbps 同时跑 Web + 游戏服）用下面这套；多园区见
# docs/deploy-multi-park.md，第二台机器把 DEPLOY_ROLE 改成 game。

DEPLOY_ROLE=all
APP_BASE=/srv/niuma/app

# ---- 园区身份 ----
# 单园区就保持 main / 主园区：/enter 会直接 302 到 /play，行为和改造前一致。
# 以后加第二台机器时：本机 id 改成 a（一号园区），并在 GAME_PARKS 里补上 b。
GAME_PARK_ID=main
GAME_PARK_NAME=主园区
# GAME_PARKS=[{"id":"main","name":"主园区","ws":"/ws","health":"/health"}]

# ---- 游戏服 ----
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=3001
# 5Mbps 出口预算：625 KB/s × 0.9(扣 TCP/TLS) − 160(Web) ≈ 400
GAME_MAX_EGRESS_KBPS=400
# 故意高于带宽可承载人数：让稀疏分布时也能吃满带宽，拥挤时由水位先关闸
GAME_MAX_ONLINE=90
GAME_TICK_BUDGET_MS=25
GAME_SERVER_MAX_MPS=120

# ---- Web ----
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_HEAP_MB=512
# 留空：浏览器走同源 /ws，由 nginx 升级到游戏服（多园区时由 GAME_PARKS 决定）
NEXT_PUBLIC_GAME_WS_URL=

# 内容审核词库：内置政治类只有占位条目，正式运营前必须配置
GAME_MODERATION_LEXICON=
