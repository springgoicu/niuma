# niuma 全局 nginx 参数（http 上下文）—— /etc/nginx/conf.d/00-niuma-http.conf
#
# 只放「必须在 http 上下文」的东西：map、upstream、gzip、文件缓存、SSL 会话。
#
# 【重要】Ubuntu 26.04 发行版的 /etc/nginx/nginx.conf 已经声明了
# sendfile / tcp_nopush / ssl_protocols / server_tokens / gzip。
# 同一上下文重复声明标量指令会让 nginx -t 报 "duplicate" 并拒绝启动，
# 所以下面只写增量；那几项保持发行版的取值（sendfile/tcp_nopush 本来就是 on）。

# WebSocket 升级：空 Upgrade 头必须发 close，否则普通请求会被上游当成劫持
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 两个上游都留在本机回环，keepalive 复用连接，省掉每个请求一次 connect()
upstream niuma_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream niuma_game {
    server 127.0.0.1:3001;
    keepalive 8;   # /health 探活与短平快请求也能复用
}

# ---- 核心网络传输 ----
# sendfile / tcp_nopush 由发行版 nginx.conf 提供（已为 on），不在此重复声明。
tcp_nodelay         on;   # 禁 Nagle：WS 的 8 字节小帧立刻离网，不攒包等 MSS
keepalive_timeout   65s;
keepalive_requests  1000;

# ---- 压缩 ----
# 静态资源命中同目录的 .gz（部署时预压缩），动态 HTML 才走运行时 gzip。
gzip_static on;
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 512;
gzip_types
    text/plain
    text/css
    text/xml
    text/javascript
    application/javascript
    application/json
    application/manifest+json
    application/xml
    image/svg+xml;

# 静态资源并发上限用的共享内存区
limit_conn_zone $binary_remote_addr zone=addr:10m;

# ---- 限流：按来源 IP ----
# 速率按「人打不出来」的密度设：正常点击、RSC 预取、断线重连都远低于此，
# 而脚本级洪水（几千 r/s）在这里就被 429 挡住，不会走到 Node/Bun。
# 30r/s × burst 60：一个页面首屏的动态请求峰值约 10~20，留三倍余量。
limit_req_zone  $binary_remote_addr zone=niuma_req:10m rate=30r/s;
# 每 IP 并发 WebSocket：一个玩家 1~2 条（多标签页），8 条是很松的上限。
# 这是游戏站最要命的一条——单 IP 开上千条连接会把内存和广播队列吃空，
# 而 Tick 只统计「发出多少字节」，它看不到连接数爆炸。
limit_conn_zone $binary_remote_addr zone=niuma_ws:10m;
limit_req_status  429;
limit_conn_status 429;

# ---- 慢连接防护 ----
# slowloris 靠「发一半请求头就不动」占满 worker 连接数。默认 60s 太长，
# 正常客户端的首字节与请求体都在毫秒级完成。
client_header_timeout 10s;
client_body_timeout   10s;
send_timeout          15s;
client_header_buffer_size 4k;
large_client_header_buffers 4 8k;

# ---- 静态文件元数据缓存 ----
# 2 vCPU 机器上省掉的就是一次次 stat()：命中后连 open() 都省了
open_file_cache          max=20000 inactive=60s;
open_file_cache_valid    30s;
open_file_cache_min_uses 2;
open_file_cache_errors   on;

# ---- TLS 会话复用 ----
# 首访是完整握手，第二次起走 session ticket；5Mbps 机器上握手省下的几百毫秒很值钱。
# ssl_protocols / ssl_prefer_server_ciphers 由发行版 nginx.conf 提供（TLS1.2+1.3）。
ssl_session_cache   shared:SSL:20m;
ssl_session_timeout 1d;
ssl_session_tickets on;
# 4k：证书链一次发完，减少一个 RTT
ssl_buffer_size     4k;

# TLS 1.3 0-RTT：会话恢复时首个请求省 1 个 RTT。
# 代价：early data 可被重放。上游目前不校验 Early-Data 头，
# 非幂等入口（Webhook POST）靠 token + 触发器单实例锁兜住；
# 若要彻底关掉重放，把这一行改成 off 即可。
ssl_early_data      on;

# ---- 反向代理缓冲 ----
# 让 Next SSR 的响应留在内存里，别落到 /var/lib/nginx 的临时文件
proxy_buffer_size          16k;
proxy_buffers              8 32k;
proxy_busy_buffers_size    64k;
proxy_temp_file_write_size 64k;

# ---- 掐掉上游指纹 ----
# 只对 proxy 响应生效：Next 可能带 X-Powered-By，Bun 会带自己的 Server 头。
# nginx 自身那一行 `Server: nginx` 不归它管 —— 见下面 @SERVER_HEADER_FILTER@。
proxy_hide_header X-Powered-By;
proxy_hide_header Server;
proxy_hide_header X-AspNet-Version;
proxy_hide_header X-Runtime;

# nginx 自己的 Server 头只有 headers-more 模块能删（原生没有「删除响应头」指令，
# server_tokens off 只是去版本号，仍会发 `Server: nginx`）。
# 渲染时按模块是否可用填入，装不了就留一行注释 —— 不能写死，
# 否则新机器上没装模块会直接 nginx -t 失败，整站起不来。
@SERVER_HEADER_FILTER@

client_max_body_size 4m;
