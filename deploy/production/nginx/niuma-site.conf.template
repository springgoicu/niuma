# niuma 站点配置 —— /etc/nginx/sites-available/niuma
#
# @DOMAIN@ / @WWW@ / @WEB_ROOT@ / @HOOK_PATH@ 由 install.sh 渲染后写入。
#
# 三条流量在同一个 server 里分流：
#   /_next/static/  /sprites/   直接由 nginx 从磁盘发（不过 Node，省 CPU 与事件循环）
#   /ws                         升级到游戏服（同源，浏览器不需要知道 3001）
#   /                           其余全部交给 Next standalone
#
# 【跨源隔离头不能漏】next.config.ts 给所有页面发了 COOP/COEP（SharedArrayBuffer
# 零拷贝控制块需要 crossOriginIsolated）。走 proxy 的响应自带这两条头，但 nginx
# 直接 alias 到磁盘的静态响应不带。Chrome 在 COEP: require-corp 页面里要求
# Worker/frame 类子上下文的脚本响应同样带 COEP，否则直接
# net::ERR_BLOCKED_BY_RESPONSE（coep-frame-resource-needs-coep-header），
# worker.onerror 的 message 还是空的 —— 表现为「连接中断，正在重连」但 WS 从未建立。
# 因此每个静态 location 都要补这三条；注意 nginx 的 add_header 继承规则：
# location 里只要出现任意一条 add_header，server 级安全头就全部不再继承，
# 所以不能只在 server 级写一次（而且 server 级加 COEP 会让 proxy 响应出现重复头）。

# 文档与接口缓存策略：页面必须每次回源校验，否则部署后用户会继续跑旧地图。
# /api/version 是客户端判断「是否需要强刷」的唯一依据，连协商缓存都不能留。
map $uri $niuma_cache_control {
    default          "no-cache, must-revalidate";
    /api/version     "no-store, max-age=0";
}

# Worker chunk 不能 immutable：它的响应头（COEP/CORP）属于部署配置，
# 文件名 hash 只反映 JS 内容。若缓存一年，服务端修好响应头后，浏览器仍拿
# 缓存里的旧头继续拒绝启动 Worker，且不会再来校验 —— 2026-11-12 线上故障就这么来的。
# 其余带内容哈希的 chunk 保持一年强缓存。
map $uri $niuma_static_cache_control {
    default           "public, max-age=31536000, immutable";
    ~*niuma-game\.    "no-cache, must-revalidate";
}

# WS 握手来源白名单：别的站点无法把玩家的浏览器当跳板连进来（CSWSH）——
# 恶意页面只要让访问者的浏览器连上 wss://本站/ws，就能白耗他的连接数配额。
# 空 Origin 放行：非浏览器客户端（探活、压测脚本）本来就不发这个头，
# 真正的连接洪水由 limit_conn 挡，这一层只管「浏览器被别的站点指使」。
map $http_origin $niuma_ws_origin_ok {
    default                     0;
    ""                          1;
    "https://@DOMAIN@"          1;
    "https://@WWW@"             1;
}

# ---------- 兜底：未授权 Host 与 IP 直连 ----------
# 全网扫描器先扫 1.2.3.4:80/443，拿到证书或页面才开始测绘域名。
# 默认 server 把这条路堵死：80 端口直接断连（444 不产生任何响应字节），
# 443 端口在 TLS 握手上就拒绝（ssl_reject_handshake），连证书都不出示，
# 扫描器拿不到 SNI 提示、拿不到证书 CN/SAN，也就拼不出我们有哪些域名。
#
# 注意 ssl_reject_handshake 需要 nginx ≥ 1.19.4（Ubuntu 22.04 起自带）。
# 它比「自签证书 + return 444」干净：自签证书本身就是一条指纹，等于告诉对方
# 「这里有人，且懒得配证书」。
server {
    listen      80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log  off;
    return 444;
}

server {
    listen      443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2       on;
    server_name _;
    ssl_reject_handshake on;
    access_log  off;
}

# ---------- 80：ACME 验证与强跳 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@ @WWW@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://@DOMAIN@$request_uri;
    }
}

# ---------- 443：www 统一跳到主域（保护 localStorage 的域隔离）----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @WWW@;

    ssl_certificate     /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;

    return 301 https://@DOMAIN@$request_uri;
}

# ---------- 443：主站 ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @DOMAIN@;

    ssl_certificate         /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    # 不开 OCSP stapling：Let's Encrypt 已停止提供 OCSP 响应，
    # 打开只会每次 reload 刷一条 "no OCSP responder URL in the certificate"

    # 0-RTT 标记。注意 nginx 的 proxy_set_header 继承规则：
    # 只要 location 里写了任意一条 proxy_set_header，就不会继承 server 级，
    # 所以下面每个 proxy location 都各自补了一条 Early-Data。
    proxy_set_header Early-Data $ssl_early_data;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 点击劫持：任何站点都不能把主站嵌进 iframe 做钓鱼页
    add_header X-Frame-Options "SAMEORIGIN" always;
    # 页面不需要定位/麦克风/摄像头，直接按 origin 关掉，连权限提示都不会弹
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # X-XSS-Protection 已被 Chrome 78+ / Edge / Firefox 移除，现在的浏览器读到它
    # 什么也不做。保留只是为了过安全扫描的基线要求；真正挡 XSS 的是 CSP，
    # 而本站昵称/聊天走 Canvas 文本渲染、不进 DOM，CSP 收益低且 Next 需要
    # unsafe-inline/unsafe-eval，配错就是白屏，所以没有启用。
    add_header X-XSS-Protection "1; mode=block" always;

    charset utf-8;
    etag on;

    # 限制 HTTP/2 单连接并发流：默认 128 会让浏览器一口气并发拉十几个 chunk，
    # 在 5Mbps 出口上瞬间挤掉游戏帧。16 保留多路复用，同时让资源排队有序下发。
    http2_max_concurrent_streams 16;

    # ---- Next 构建产物（文件名带内容哈希，永久强缓存）----
    # 直接 alias 到磁盘：2 vCPU 上每一个走 Node 的静态请求都在和游戏 Tick 抢时间
    # 静态响应的跨源隔离头：与 Next 上游的 /:path* 策略保持一致。
    # webpack 的 Worker chunk 也落在这个 location，缺 COEP 会被浏览器直接拦掉。
    #
    # 【alias 目录穿越】location 与 alias 的末尾斜杠必须同时有或同时无：
    # 写成 `location ^~ /_next/static` + `alias .../static/;` 时，请求
    # `/_next/static../etc/passwd` 会被拼成 `.../static/../etc/passwd` —— 穿越到上一级。
    # 两边都带尾斜杠时，URI 的 `..` 已在 nginx 归一化阶段被吃掉，拼不出越界路径。
    location ^~ /_next/static/ {
        alias @WEB_ROOT@/.next/static/;
        add_header Cache-Control $niuma_static_cache_control always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        # 前 512KB 全速（gzip 后的构建产物几乎全部落在这个窗口内，等于秒开），
        # 超过部分单流 200KB/s。不去掉限速：高并发时一条连接顶满 5Mbps 会把
        # WebSocket 的游戏帧挤掉；200KB/s 让大资源仍有 1.6Mbps，留足余量给游戏服。
        limit_rate_after 512k;
        limit_rate 200k;
        limit_conn addr 8;
        access_log off;
    }

    # ---- 图集清单：版本号与客户端布局必须实时对齐，绝不缓存 ----
    location = /sprites/manifest.json {
        alias @WEB_ROOT@/public/sprites/manifest.json;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        # 清单 gzip 后不到 4KB，限速没有意义，去掉以免与上面的首包策略不一致
        access_log off;
    }

    # ---- 图集 PNG：文件名固定、内容随版本变，靠 ETag 每次校验 ----
    # 不能沿用旧的 7 天强缓存：新 JS 配旧图集会让地图看起来「没更新」。
    # 后续若改成内容哈希文件名，可以恢复 immutable 长缓存。
    location ^~ /sprites/ {
        alias @WEB_ROOT@/public/sprites/;
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        # 图集是 PNG，gzip 压不动，尺寸随帧数增长会突破 512KB：
        # 首包 512KB 全速，超出部分 250KB/s（比 JS 略宽，图集是一次性整包加载）
        limit_rate_after 512k;
        limit_rate 250k;
        access_log off;
    }

    # ---- 品牌与图标资源 ----
    location = /favicon.ico {
        alias @WEB_ROOT@/public/favicon.ico;
        add_header Cache-Control "public, max-age=604800" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    location ^~ /brand/ {
        alias @WEB_ROOT@/public/brand/;
        add_header Cache-Control "public, max-age=2592000" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # ---- 游戏服探活：选园页靠它拿在线人数与延迟 ----
    location = /health {
        # 选园页每张卡片探一次，加上失败重试也就个位数；超出这个量说明在被人刷
        limit_req zone=niuma_req burst=20 nodelay;
        # 游戏服自己也会带一份 CORS 头，两边都发会出现两条
        # Access-Control-Allow-Origin，浏览器直接判为非法
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store, no-cache" always;
        # 这一层自己写了 add_header，就吃不到 server 级的安全头了。
        # 只补对 JSON 响应真正有意义的两条：HSTS（浏览器缓存域名策略）与
        # nosniff（防止探活响应被某些客户端当 HTML 嗅探）。X-Frame / Permissions
        # 对一段 JSON 没有任何作用，加上只是白占字节。
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_pass http://niuma_game;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Early-Data $ssl_early_data;
        # 后端挂了立刻 502，不拖住客户端
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        access_log off;
    }

    # ---- 游戏服 WebSocket：零缓冲、零延迟 ----
    location /ws {
        # 先过来源白名单，再谈连接数：被别的站点指使的浏览器连握手都不该完成
        if ($niuma_ws_origin_ok = 0) { return 403; }

        # 单 IP 并发连接与握手频率：正常玩家 1~2 条、重连不过几秒一次。
        # 16 是为了容纳「一个宿舍/公司共用一个出口 IP」的常见情况——
        # 校园网里十来个玩家同 IP 时，8 会误伤后面几个，而 16 条对一个 IP
        # 的内存开销仍在几十 KB 量级，挡洪水靠的是握手频率与带宽水位。
        limit_conn niuma_ws 16;
        limit_req  zone=niuma_req burst=10 nodelay;

        proxy_pass http://niuma_game;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header Early-Data $ssl_early_data;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 5s;

        proxy_buffering off;
        proxy_socket_keepalive on;
        tcp_nodelay on;   # 实时小包直通，不攒包
        access_log off;
    }

    # ---- Gitee Webhook：路径本身是密钥，再叠一层 token（见 webhook.mjs）----
    location = /@HOOK_PATH@/deploy {
        proxy_pass http://127.0.0.1:9100/deploy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Early-Data $ssl_early_data;
        proxy_read_timeout 30s;
        access_log /var/log/nginx/niuma-hook.log;
    }

    # ---- 扫描器常探的路径：不产生任何响应字节，也不写日志 ----
    # 用 444 而不是 404：444 连状态行都不发，扫描器分不清「路径不存在」和
    # 「被拦了」，只能记成连接被重置；404 反而会明确告诉它「这台是 nginx，
    # 且这个路径确实没有」。同时 444 不占上游、不写一行日志 —— 扫描流量
    # 每天几千条，写进 access.log 就是在替攻击者填磁盘。
    # 正则 location 优先级低于 ^~，所以 /_next/static/ 与 /sprites/ 不受影响。

    # 隐藏文件与隐藏目录：.env 是数据库口令，.git 是整个历史（含未来代码）
    location ~* ^/\.(env|git|svn|hg|aws|ssh|npmrc|htaccess|htpasswd|DS_Store|idea|vscode)([/.]|$) {
        access_log off;
        return 444;
    }

    # 源码清单与锁文件：package.json 暴露依赖版本与构建脚本，
    # tsconfig 暴露路径别名，Dockerfile 暴露运行时布局
    location ~* ^/(package(-lock)?\.json|pnpm-lock\.yaml|yarn\.lock|tsconfig\.json|jsconfig\.json|composer\.(json|lock)|next\.config\.[a-z]+|Dockerfile|docker-compose\.[a-z]+)$ {
        access_log off;
        return 444;
    }

    # 备份、导出、数据库转储：本站没有任何路由以这些后缀结尾
    location ~* \.(bak|backup|old|orig|save|swp|swo|sql|sqlite|dump|tar|tgz|7z|rar|config)$ {
        access_log off;
        return 444;
    }

    # CMS 与工具入口：本站没有 wordpress / phpmyadmin，出现即扫描
    location ~* ^/(wp-(admin|login|content|includes|json)|xmlrpc\.php|phpmyadmin|pma|adminer|cgi-bin/|vendor/|\.well-known/security\.txt) {
        access_log off;
        return 444;
    }

    # 脚本语言后缀：本站是 Node，不存在任何 php/asp/jsp/cgi 入口
    location ~* \.(php|php[3-8]|phtml|asp|aspx|jsp|jspx|cgi|pl|py|rb|sh)$ {
        access_log off;
        return 444;
    }

    # ---- 默认路由：Next.js Standalone SSR/RSC ----
    location / {
        # 只限制动态请求：静态 chunk 走上面的 ^~ location，不消耗这里的配额。
        # 30r/s + burst 60：首屏并发十几个 RSC/页面请求也碰不到。
        limit_req zone=niuma_req burst=60 nodelay;
        proxy_pass http://niuma_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_set_header Early-Data $ssl_early_data;
        # 缓冲开着：Next 渲染完一次性交给 nginx，尽快释放 Node 进程
        proxy_buffering on;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        # 文档与接口一律回源校验：部署后刷新必须拿到新 HTML，不能靠浏览器启发式缓存。
        # 版本接口由 map 单独钉成 no-store；其余动态响应允许 304 协商。
        proxy_hide_header Cache-Control;
        add_header Cache-Control $niuma_cache_control always;
        # location 内一旦出现 add_header，server 级安全头不再继承，必须在这里补回。
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # 页面不需要被任何站点 iframe 嵌入（防点击劫持），也不需要用定位/麦克风/摄像头
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }
}
