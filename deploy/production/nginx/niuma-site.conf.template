# niuma 站点配置 —— /etc/nginx/sites-available/niuma
#
# @DOMAIN@ / @WWW@ / @WEB_ROOT@ / @HOOK_PATH@ 由 bootstrap.sh 替换后写入。
#
# 三条流量在同一个 server 里分流：
#   /_next/static/  /sprites/   直接由 nginx 从磁盘发（不过 Node，省 CPU 与事件循环）
#   /ws                         升级到游戏服（同源，浏览器不需要知道 3001）
#   /                           其余全部交给 Next standalone

# ---------- 80：只做 ACME 验证与跳转 ----------
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@ @WWW@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://@DOMAIN@$request_uri;
    }
}

# ---------- 443：www 统一跳到主域（存档按域名隔离，不能有两个入口）----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @WWW@;

    ssl_certificate     /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;

    return 301 https://@DOMAIN@$request_uri;
}

# ---------- 443：主站 ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @DOMAIN@;

    ssl_certificate         /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    # 不再开 OCSP stapling：Let's Encrypt 已经停止提供 OCSP 响应，
    # 打开只会每次 reload 报一条 "no OCSP responder URL in the certificate"

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    charset utf-8;
    etag on;

    # ---- Next 构建产物：文件名带内容哈希，可以永久缓存 ----
    # 直接 alias 到磁盘：2 vCPU 上每一个走 Node 的静态请求都在和游戏 Tick 抢时间
    location ^~ /_next/static/ {
        alias @WEB_ROOT@/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # 首访突发限速：把 Web 最坏带宽钉死，剩余全留给游戏服。
        # limit_rate_after 让第一个 256KB 跑满，避免小 chunk 也被磨成 200KB/s
        limit_rate_after 256k;
        limit_rate 200k;
        limit_conn addr 12;
        access_log off;
    }

    # ---- 图集清单：版本号与客户端布局必须一致，绝不能缓存 ----
    location = /sprites/manifest.json {
        alias @WEB_ROOT@/public/sprites/manifest.json;
        add_header Cache-Control "no-cache" always;
        limit_rate 200k;
        access_log off;
    }

    # ---- 图集 PNG：文件名固定、内容随版本变，缓存压到 7 天 ----
    location ^~ /sprites/ {
        alias @WEB_ROOT@/public/sprites/;
        add_header Cache-Control "public, max-age=604800" always;
        limit_rate_after 256k;
        limit_rate 300k;
        access_log off;
    }

    # ---- 品牌图（favicon / iOS 图标）同样由构建产出 ----
    location = /favicon.ico {
        alias @WEB_ROOT@/public/favicon.ico;
        expires 7d;
        access_log off;
    }

    location ^~ /brand/ {
        alias @WEB_ROOT@/public/brand/;
        expires 30d;
        access_log off;
    }

    # ---- 探活：唯一放开 CORS 的接口，选园页靠它拿在线人数与延迟 ----
    location = /health {
        # 游戏服自己也会带一份 CORS 头，两边都发会出现两条 Access-Control-Allow-Origin，
        # 浏览器会直接判为非法；这里统一由 nginx 发，把上游那条藏掉
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://niuma_game;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }

    # ---- 游戏服 WebSocket ----
    location /ws {
        proxy_pass http://niuma_game;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        # WS 空闲不能被 60s 默认超时掐断
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # 实时帧不过缓冲：多一层缓冲就多一帧延迟
        proxy_buffering off;
        proxy_socket_keepalive on;
        access_log off;
    }

    # ---- Gitee Webhook：路径本身是密钥，再叠一层 token（见 webhook.mjs）----
    location = /@HOOK_PATH@/deploy {
        proxy_pass http://127.0.0.1:9100/deploy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        access_log /var/log/nginx/niuma-hook.log;
    }

    # ---- 其余交给 Next ----
    location / {
        proxy_pass http://niuma_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
