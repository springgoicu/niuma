# Gitee Webhook 触发器配置（服务器上位于 /etc/niuma/webhook.env）
#
# HOOK_TOKEN 与 Gitee 仓库 → 管理 → WebHooks 里的「WebHook 密码」保持一致。
# HOOK_PATH  是 nginx 暴露的路径前缀，随便换成一串随机字符即可。
#
# 推荐在 Gitee 里填的 URL：
#   https://bangying.top/<HOOK_PATH>/deploy
HOOK_TOKEN=replace-me
PORT=9100
DEPLOY_BRANCH=master
DEPLOY_SCRIPT=/srv/niuma/src/deploy/production/deploy.sh
LOG_FILE=/var/log/niuma/webhook.log
