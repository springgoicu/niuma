# niuma 安装参数 —— 复制成 deploy/production/install.env 后按需修改
#
#   cp deploy/production/install.env.example deploy/production/install.env
#   sudo bash deploy/production/install.sh
#
# 这个文件是「一架新机器怎么装」，改完重跑 install.sh 即可（幂等）。
# 站点跑起来之后的运行时参数不在这里，在 /etc/niuma/niuma.env。

# ---- 域名 ----
DOMAIN=bangying.top
WWW=www.bangying.top
# Let's Encrypt 通知邮箱（证书到期/吊销时用）
CONTACT_EMAIL=springgo_icu@163.com

# ---- 代码来源 ----
# 私有仓库用 HTTPS + 账号密码，install.sh 会写进部署用户的 ~/.git-credentials（600）；
# 换成 git@gitee.com:owner/repo.git 也可以（此时需要先配好部署公钥）
REPO=https://gitee.com/mySia/niuma.git
BRANCH=master
GIT_USER=
GIT_PASS=

# ---- 目录 ----
APP_BASE=/srv/niuma/app
SRC_DIR=/srv/niuma/src

# ---- 开关 ----
# 1 = 跳过证书签发（域名还没解析时用，先让站点用自签证书起来）
SKIP_CERT=0
# 1 = 只装环境不发版（调试用）
SKIP_DEPLOY=0
